# Secrets and anything that could carry live brokerage credentials
.env
.env.*
*.token
*.pem
credentials.json

# Live account data must never be committed. Mock data only.
data/portfolio/live_*.json
data/sessions/*.jsonl
data/sessions/*.json

# Personal watchlist is user-editable local state, seeded on first run —
# not a fixture to ship or overwrite in git.
data/portfolio/watchlist.json

# Personal chat history — not a fixture to ship, auto-prunes after a week.
data/conversations/

# Traces and eval output are local artifacts
logs/
evals/results/*.json

# Cached responses from live SEC EDGAR fetches (network artifacts, not source)
data/edgar_cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
